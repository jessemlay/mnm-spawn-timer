<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the system-tray NotifyIcon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SpawnTimer</AssemblyName>
    <RootNamespace>SpawnTimer</RootNamespace>
    <!-- CI appends -ci.N to this; a pushed tag like v1.2.0 sets the full version. -->
    <VersionPrefix>1.6.2</VersionPrefix>
    <Product>Spawn Timer for Monsters &amp; Memories</Product>
    <!-- Exe icon: Explorer, desktop/Start Menu shortcuts and the uninstall entry all use it. -->
    <ApplicationIcon>Assets\SpawnTimer.ico</ApplicationIcon>
    <!-- Single-file publish: pack SQLite's native e_sqlite3.dll into the exe so the installer stays one file. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded for the tray icon and window icons. -->
    <Resource Include="Assets\SpawnTimer.ico" />
    <!-- tools/IconGen is a separate little project that draws the icon. -->
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <Page Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>

</Project>
