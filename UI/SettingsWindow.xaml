<Window x:Class="SpawnTimer.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SpawnTimer.UI"
        Title="Spawn Timer · Settings" Width="760" Height="600" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen" FontSize="13" Icon="/Assets/SpawnTimer.ico">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="ui:HotkeyBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Click="Close_Click" Margin="0" MinWidth="90" />
            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                       Text="Changes apply right away. Overlays are unlocked while this window is open, so drag them where you want." />
        </DockPanel>

        <TabControl>
            <!-- TIMERS -->
            <TabItem Header="Timers">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Margin="0,0,14,0">
                        <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="0,8,0,0">
                            <Button Content="Add" Click="AddTimer_Click" Padding="4,3" Margin="0,0,4,0" />
                            <Button Content="Remove" Click="RemoveTimer_Click" Padding="4,3" Margin="0,0,4,0" />
                            <Button Content="▲" Click="MoveUp_Click" ToolTip="Move up" Padding="4,3" Margin="0,0,4,0" />
                            <Button Content="▼" Click="MoveDown_Click" ToolTip="Move down" Padding="4,3" Margin="0" />
                        </UniformGrid>
                        <ListBox x:Name="TimerListBox" ItemsSource="{Binding Timers}" DisplayMemberPath="ListLabel" />
                    </DockPanel>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <Grid DataContext="{Binding SelectedItem, ElementName=TimerListBox}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=TimerListBox}" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource Label}" Text="Name" />
                            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Respawn time" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <TextBox Width="90" Text="{Binding DurationText}" />
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Text="m:ss, h:mm:ss or seconds (e.g. 6:40)" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Warn at (sec)" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <TextBox Width="90" Text="{Binding WarnSec}" />
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Text="Turns yellow and beeps. 0 = off." />
                            </StackPanel>

                            <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Restart hotkey" />
                            <StackPanel Grid.Row="3" Grid.Column="1">
                                <ui:HotkeyBox Value="{Binding RestartHotkey}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Optional. Restarts this timer directly, whichever timer is selected." />
                            </StackPanel>

                            <Separator Grid.Row="4" Grid.ColumnSpan="2" Margin="0,12" />

                            <CheckBox Grid.Row="5" Grid.ColumnSpan="2" IsChecked="{Binding AutoStart}"
                                      Content="Restart automatically when one of these corpses is looted" />

                            <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="Mob names" VerticalAlignment="Top" Margin="0,6,12,0" />
                            <TextBox Grid.Row="6" Grid.Column="1" Height="96" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Text="{Binding MobNames}" />

                            <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Hint}">
                                One name per line, exactly as the corpse is named (e.g. General Overlord Bloodynose).
                                End with * to match the start of a name (e.g. a skeletal*). Requires Game data to be on.
                                The game only records loot, so the timer starts when the corpse is looted, not when the mob dies.
                            </TextBlock>

                            <TextBlock Grid.Row="8" Style="{StaticResource Label}" Text="Placeholder mobs" VerticalAlignment="Top" Margin="0,10,12,0" />
                            <TextBox Grid.Row="8" Grid.Column="1" Height="56" Margin="0,8,0,3" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Text="{Binding PlaceholderNames}" />

                            <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource Hint}">
                                Mobs that can spawn at this spot instead of the named. Looting one while the timer is at zero
                                restarts it as a new cycle ("PH"), and the alert says the spawn could be either. Placeholder kills
                                only count once the timer has run out, so the same mob dying elsewhere won't reset a running countdown.
                                Don't know the name? /consider whatever spawns at the named's spot when the timer is up.
                            </TextBlock>

                            <DockPanel Grid.Row="10" Grid.Column="1" Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Content="Reset history" Margin="8,0,0,0" Click="ResetHistory_Click" />
                                <TextBlock Text="{Binding HistorySummary, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
                            </DockPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- HOTKEYS -->
            <TabItem Header="Hotkeys">
                <StackPanel Margin="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource Label}" Text="Start / resume" />
                        <ui:HotkeyBox Grid.Column="1" Value="{Binding Hotkeys.Start}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="Starts the selected (▶) timer." />

                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Stop" />
                        <ui:HotkeyBox Grid.Row="1" Grid.Column="1" Value="{Binding Hotkeys.Stop}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="First press pauses, second press resets." />

                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Restart" />
                        <ui:HotkeyBox Grid.Row="2" Grid.Column="1" Value="{Binding Hotkeys.Restart}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="Full countdown from now. Press it when the mob dies." />

                        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Select next timer" />
                        <ui:HotkeyBox Grid.Row="3" Grid.Column="1" Value="{Binding Hotkeys.NextTimer}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="Moves the ▶ marker." />

                        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Unlock / lock overlays" />
                        <ui:HotkeyBox Grid.Row="4" Grid.Column="1" Value="{Binding Hotkeys.ToggleEdit}" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="Unlock to drag overlays without opening Settings." />

                        <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Item lookup" />
                        <ui:HotkeyBox Grid.Row="5" Grid.Column="1" Value="{Binding Hotkeys.ItemSearch}" />
                        <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="Opens/closes the item search over the game." />
                    </Grid>

                    <CheckBox Margin="0,14,0,0" IsChecked="{Binding Hotkeys.HoldToMove}"
                              Content="Hold Ctrl+Shift to drag overlays (no need to unlock first)" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4">
                        You can also click the tray icon once to unlock or lock all overlays.
                    </TextBlock>

                    <CheckBox Margin="0,10,0,4" IsChecked="{Binding Hotkeys.PassThrough}"
                              Content="Also send hotkey presses to the game" />
                    <TextBlock Style="{StaticResource Hint}">
                        Off: the game never sees the key (safest for combos like Ctrl+Alt+1).
                        On: lets you bind a timer to a key you already use in-game, e.g. your loot or attack key.
                    </TextBlock>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0">
                        Hotkeys work while the game has focus. If they don't, the game may be running as administrator.
                        In that case, run Spawn Timer as administrator too.
                    </TextBlock>
                </StackPanel>
            </TabItem>

            <!-- OVERLAYS -->
            <TabItem Header="Overlays">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="Timer overlay">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding TimerOverlay.Visible}" Content="Show timer overlay" />
                                <CheckBox IsChecked="{Binding TimerOverlay.HideIdle}" Content="Hide timers that aren't running (the selected one always shows)" />
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource Label}" Width="130" Text="Size" />
                                    <TextBlock DockPanel.Dock="Right" Width="44" Text="{Binding TimerOverlay.Scale, StringFormat={}{0:0.0}×}" VerticalAlignment="Center" />
                                    <Slider Minimum="0.6" Maximum="3" Value="{Binding TimerOverlay.Scale}" TickFrequency="0.1" IsSnapToTickEnabled="True" />
                                </DockPanel>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource Label}" Width="130" Text="Background" />
                                    <TextBlock DockPanel.Dock="Right" Width="44" Text="{Binding TimerOverlay.BackgroundOpacity, StringFormat={}{0:0}%}" VerticalAlignment="Center" />
                                    <Slider Minimum="0" Maximum="100" Value="{Binding TimerOverlay.BackgroundOpacity}" TickFrequency="5" IsSnapToTickEnabled="True" />
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Session meter (needs Game data)">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding MeterOverlay.Visible}" Content="Show session meter" />
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource Label}" Width="130" Text="Size" />
                                    <TextBlock DockPanel.Dock="Right" Width="44" Text="{Binding MeterOverlay.Scale, StringFormat={}{0:0.0}×}" VerticalAlignment="Center" />
                                    <Slider Minimum="0.6" Maximum="3" Value="{Binding MeterOverlay.Scale}" TickFrequency="0.1" IsSnapToTickEnabled="True" />
                                </DockPanel>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource Label}" Width="130" Text="Background" />
                                    <TextBlock DockPanel.Dock="Right" Width="44" Text="{Binding MeterOverlay.BackgroundOpacity, StringFormat={}{0:0}%}" VerticalAlignment="Center" />
                                    <Slider Minimum="0" Maximum="100" Value="{Binding MeterOverlay.BackgroundOpacity}" TickFrequency="5" IsSnapToTickEnabled="True" />
                                </DockPanel>

                                <TextBlock Margin="0,10,0,2" FontWeight="SemiBold" Text="Rows" />
                                <UniformGrid Columns="2">
                                    <CheckBox IsChecked="{Binding Meter.ShowZone}" Content="Zone" />
                                    <CheckBox IsChecked="{Binding Meter.ShowSessionTime}" Content="Session time" />
                                    <CheckBox IsChecked="{Binding Meter.ShowKills}" Content="Corpses looted" />
                                    <CheckBox IsChecked="{Binding Meter.ShowKillRate}" Content="Corpses per hour" />
                                    <CheckBox IsChecked="{Binding Meter.ShowCoin}" Content="Coin looted" />
                                    <CheckBox IsChecked="{Binding Meter.ShowCoinRate}" Content="Coin looted per hour" />
                                    <CheckBox IsChecked="{Binding Meter.ShowItems}" Content="Items looted" />
                                    <CheckBox IsChecked="{Binding Meter.ShowLevels}" Content="Levels gained" />
                                </UniformGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <CheckBox IsChecked="{Binding Meter.ShowTopMobs}" Content="Top mobs, show" Width="150" />
                                    <TextBox Width="44" Text="{Binding Meter.TopMobsCount}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding Meter.ShowRecentLoot}" Content="Recent loot, show" Width="150" />
                                    <TextBox Width="44" Text="{Binding Meter.RecentLootCount}" />
                                    <TextBlock Text="for" VerticalAlignment="Center" Margin="6,0,6,0" />
                                    <TextBox Width="44" Text="{Binding Meter.RecentLootMinutes}" />
                                    <TextBlock Text="minutes (0 = always)" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Per-hour rates follow the last" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Width="44" Text="{Binding Meter.RateWindowMinutes}" />
                                    <TextBlock Text="minutes" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}">
                                    Rates fade when you stop looting and reach 0 after about 4× this long with no loot.
                                    0 = whole-session average.
                                </TextBlock>
                                <CheckBox IsChecked="{Binding Meter.AutoNewSession}" Margin="0,8,0,0"
                                          Content="Follow the game: new session when it launches, session ends when it closes" />
                                <StackPanel Orientation="Horizontal" Margin="20,2,0,0">
                                    <TextBlock Text="…or when you loot again after" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Width="44" Text="{Binding Meter.NewSessionAfterIdleMinutes}" />
                                    <TextBlock Text="minutes without loot" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Export session to CSV…" Click="ExportSession_Click" />
                                    <Button Content="Restart session" Click="ResetSession_Click" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Item lookup (hotkey on the Hotkeys tab)">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Label}" Width="130" Text="Your class code" />
                                    <TextBox Width="60" Text="{Binding ItemLookup.YourClass}" CharacterCasing="Upper" MaxLength="4" />
                                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Text="e.g. CLR, as used on wiki item pages. Cards then show ✓ usable / ✗ not usable." />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding ItemLookup.PreloadZoneItems}"
                                          Content="Preload the current zone's items when you enter a zone (instant lookups there)" />
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource Label}" Width="130" Text="Size" />
                                    <TextBlock DockPanel.Dock="Right" Width="44" Text="{Binding ItemOverlay.Scale, StringFormat={}{0:0.0}×}" VerticalAlignment="Center" />
                                    <Slider Minimum="0.6" Maximum="2.5" Value="{Binding ItemOverlay.Scale}" TickFrequency="0.1" IsSnapToTickEnabled="True" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}">
                                    While the search is open your typing goes to the box, not the game (the game keeps focus).
                                    Item data: M&amp;M Wiki on Miraheze (CC BY-SA 4.0), cached for 7 days.
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>

                        <TextBlock Style="{StaticResource Hint}">
                            Overlays show on top of the game in Borderless or Windowed mode.
                            No app can draw over exclusive fullscreen, so set the game to borderless if they disappear.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- GAME DATA -->
            <TabItem Header="Game data">
                <StackPanel Margin="10">
                    <CheckBox FontWeight="SemiBold" IsChecked="{Binding Ledger.Enabled}"
                              Content="Read the game's Ledger files (loot log) for auto-restart and the session meter" />

                    <Border Background="#FFF8E1" BorderBrush="#F0C36D" BorderThickness="1" Padding="10" Margin="0,8">
                        <TextBlock TextWrapping="Wrap" FontSize="12">
                            <Run FontWeight="Bold">Read this first.</Run>
                            M&amp;M saves a loot ledger on your PC (AppData\LocalLow\Niche Worlds Cult\Monsters and Memories).
                            This option only reads those files. It never touches the game, its memory or its network traffic.
                            However, the game's Play Nice Policy forbids third-party "screen readers/parsers" and "data mining",
                            and doesn't say whether reading your own ledger files counts.
                            If you want to be certain, ask the developers before turning this on.
                            Timers and hotkeys work fully with this off.
                        </TextBlock>
                    </Border>

                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0">
                        The game records loot, coin, vendor sales, level-ups and party changes. It does not record damage or
                        healing, so a DPS/HPS meter isn't possible from these files.
                    </TextBlock>

                    <TextBlock Margin="0,14,0,2" FontWeight="SemiBold" Text="Status" />
                    <TextBlock x:Name="LedgerStatus" TextWrapping="Wrap" />

                    <TextBlock Margin="0,14,0,2" FontWeight="SemiBold" Text="Character folder (leave empty to pick the character you're playing)" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,3,0,3" Click="Browse_Click" />
                        <TextBox Text="{Binding Ledger.FolderOverride}" />
                    </DockPanel>
                </StackPanel>
            </TabItem>

            <!-- ALERTS -->
            <TabItem Header="Alerts">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="Timer alerts">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding Alerts.SoundOnSpawn}" Content="Play a sound when a timer reaches zero" />
                                <CheckBox IsChecked="{Binding Alerts.SoundOnWarning}" Content="Play a short beep at the warning time" />
                                <CheckBox IsChecked="{Binding Alerts.SpeakOnSpawn}" Content="Speak the timer's name when it reaches zero (Windows voice)" />
                                <CheckBox IsChecked="{Binding Alerts.BannerOnTimerUp}" Content="Show a banner when a timer reaches zero" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Test timer up" Click="TestTimerUp_Click" />
                                    <Button Content="Test warning" Click="TestWarn_Click" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Item drop alerts (needs Game data)">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Add items from a zone…" Margin="0" Click="ZoneImport_Click"
                                            ToolTip="Look up what drops in a zone (M&amp;M Wiki + MnM Drops) and pick items to alert on" />
                                    <CheckBox IsChecked="{Binding DropAlerts.Enabled}" Content="Alert when one of these items is looted" />
                                </DockPanel>
                                <TextBox Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Text="{Binding DropAlerts.ItemNames}" />
                                <TextBlock Style="{StaticResource Hint}">
                                    One item per line. Exact name, or use * as a wildcard: Head of*, *Longbow, *Bloodynose*.
                                    Covers loot by you and your party; the game doesn't record drops for players outside your party.
                                </TextBlock>
                                <CheckBox IsChecked="{Binding DropAlerts.MineOnly}" Content="Only items I loot myself" />
                                <CheckBox IsChecked="{Binding DropAlerts.Sound}" Content="Play a sound" />
                                <CheckBox IsChecked="{Binding DropAlerts.Speak}" Content="Speak the item name" />
                                <Button Content="Test drop alert" HorizontalAlignment="Left" Margin="0,6,0,0" Click="TestDrop_Click" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Named mobs (needs Game data)">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding Named.Enabled}" Content="Track named mobs" />
                                <CheckBox IsChecked="{Binding Named.AutoDetect}"
                                          Content="Treat capitalized corpse names as named (General Overlord Bloodynose, not a Bloodynose sergeant)" />
                                <TextBlock Margin="0,6,0,2" Text="Also treat these as named (rare &quot;a ...&quot; spawns, placeholders):" />
                                <TextBox Height="56" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Text="{Binding Named.WatchNames}" />
                                <TextBlock Margin="0,6,0,2" Text="Never treat these as named:" />
                                <TextBox Height="56" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Text="{Binding Named.IgnoreNames}" />
                                <CheckBox Margin="0,8,0,4" IsChecked="{Binding Named.AlertOnLoot}" Content="Alert when a named mob is looted (&quot;named down&quot;)" />
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding Named.AutoTimers}" VerticalAlignment="Center"
                                              Content="Create a respawn timer for each new named, default respawn" />
                                    <TextBox Width="70" Margin="8,3,0,3" Text="{Binding Named.DefaultRespawnText}" />
                                </StackPanel>
                                <TextBlock Margin="0,6,0,2" Text="Don't create timers for these named (removed timers are added here):" />
                                <TextBox Height="44" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Text="{Binding Named.NoTimerNames}" />
                                <TextBlock Style="{StaticResource Hint}">
                                    The game logs loot, not spawns. When a named respawn timer reaches zero you get a
                                    "spawn due" alert, predicted from when the corpse was looted. Edit each named's real
                                    respawn time on the Timers tab once you know it.
                                </TextBlock>
                                <CheckBox IsChecked="{Binding Named.Sound}" Content="Play a sound" />
                                <CheckBox IsChecked="{Binding Named.Speak}" Content="Speak the mob's name" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Test named down" Click="TestNamed_Click" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Alert banner">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding AlertOverlay.Visible}" Content="Show alert banners on screen" />
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource Label}" Width="130" Text="Size" />
                                    <TextBlock DockPanel.Dock="Right" Width="44" Text="{Binding AlertOverlay.Scale, StringFormat={}{0:0.0}×}" VerticalAlignment="Center" />
                                    <Slider Minimum="0.6" Maximum="3" Value="{Binding AlertOverlay.Scale}" TickFrequency="0.1" IsSnapToTickEnabled="True" />
                                </DockPanel>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource Label}" Width="130" Text="Background" />
                                    <TextBlock DockPanel.Dock="Right" Width="44" Text="{Binding AlertOverlay.BackgroundOpacity, StringFormat={}{0:0}%}" VerticalAlignment="Center" />
                                    <Slider Minimum="0" Maximum="100" Value="{Binding AlertOverlay.BackgroundOpacity}" TickFrequency="5" IsSnapToTickEnabled="True" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource Label}" Width="130" Text="Show for (sec)" />
                                    <TextBox Width="60" Text="{Binding Alerts.BannerSeconds}" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- UPDATES -->
            <TabItem Header="Updates">
                <StackPanel Margin="10">
                    <CheckBox IsChecked="{Binding Updates.CheckForUpdates}"
                              Content="Check for updates when the app starts and every 6 hours" />
                    <CheckBox IsChecked="{Binding Updates.InstallAutomatically}" Margin="0,4,0,0"
                              Content="Install updates automatically when the app starts" />
                    <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,0">
                        Updates only auto-install at startup, never in the middle of a session. Windows asks for admin
                        permission once, then the app restarts on the new version with your settings. Updates found
                        later show a banner and a tray item ("Install update") instead.
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Check now" Click="CheckUpdates_Click" />
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatusText" Margin="0,8,0,0" TextWrapping="Wrap" />

                    <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0">
                        Updates come only from the GitHub releases of jessemlay/mnm-spawn-timer over HTTPS, and the installer
                        is checked against the SHA-256 checksum GitHub publishes before it runs.
                    </TextBlock>

                    <TextBlock Margin="0,18,0,2" FontWeight="SemiBold" Text="Your settings" />
                    <TextBlock x:Name="SettingsPathText" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Style="{StaticResource Hint}">
                        Kept across reinstalls and updates. settings.json.bak next to it is the previous session's copy.
                    </TextBlock>
                    <Button Content="Open settings folder" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OpenSettingsFolder_Click" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
