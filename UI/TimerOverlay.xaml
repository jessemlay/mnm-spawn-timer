<ui:OverlayWindow x:Class="SpawnTimer.UI.TimerOverlay"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="clr-namespace:SpawnTimer.UI"
                  Title="Spawn Timer">
    <ui:OverlayWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="LookText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Look}" Value="Idle">
                    <Setter Property="Foreground" Value="#B3FFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Look}" Value="Paused">
                    <Setter Property="Foreground" Value="#8FB8DE" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Look}" Value="Warning">
                    <Setter Property="Foreground" Value="#FFC857" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Look}" Value="Expired">
                    <Setter Property="Foreground" Value="#FF5C5C" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Blink">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35"
                                                 Duration="0:0:0.45" AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Blink" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LookFill" TargetType="Border">
            <Setter Property="Background" Value="#7FD4FF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Look}" Value="Idle">
                    <Setter Property="Background" Value="#55FFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Look}" Value="Paused">
                    <Setter Property="Background" Value="#8FB8DE" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Look}" Value="Warning">
                    <Setter Property="Background" Value="#FFC857" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Look}" Value="Expired">
                    <Setter Property="Background" Value="#FF5C5C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:OverlayWindow.Resources>

    <Border x:Name="Frame" CornerRadius="8" Padding="12,8" BorderThickness="2" BorderBrush="Transparent">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>
        <StackPanel MinWidth="220">
            <StackPanel.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="4" Color="Black" Opacity="0.9" />
            </StackPanel.Effect>

            <TextBlock x:Name="EditHint" Visibility="Collapsed" Foreground="#7FD4FF" FontSize="11" Margin="0,0,0,4"
                       Text="SPAWN TIMERS · drag to move · click tray icon to lock" />
            <TextBlock x:Name="EmptyText" Visibility="Collapsed" Foreground="#B3FFFFFF" FontSize="13"
                       Text="No timers. Add one in Settings." />

            <ItemsControl x:Name="TimerList" Focusable="False">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Visibility" Value="{Binding ShowInOverlay, Converter={StaticResource BoolToVis}}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" MinWidth="110" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="▶" FontSize="10" VerticalAlignment="Center" Foreground="#7FD4FF"
                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="11"
                                               FontWeight="Bold" Margin="8,0,0,0" Style="{StaticResource LookText}" />
                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#E6FFFFFF"
                                               TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                </DockPanel>
                                <Border Height="4" CornerRadius="2" Background="#33FFFFFF" Margin="0,4,0,0">
                                    <Border CornerRadius="2" RenderTransformOrigin="0,0.5" Style="{StaticResource LookFill}">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Progress}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                                <TextBlock Text="{Binding HistoryText}" FontSize="10.5" Foreground="#A6FFFFFF" Margin="0,3,0,0"
                                           TextWrapping="Wrap" MaxWidth="240">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HistoryText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding DisplayText}" FontSize="30" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular" MinWidth="78" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource LookText}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</ui:OverlayWindow>
