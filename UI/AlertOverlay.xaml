<ui:OverlayWindow x:Class="SpawnTimer.UI.AlertOverlay"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="clr-namespace:SpawnTimer.UI"
                  Title="Spawn Timer Alerts">
    <Border x:Name="Frame" BorderThickness="2" BorderBrush="Transparent" CornerRadius="8">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>
        <StackPanel MinWidth="320">
            <Border x:Name="Placeholder" Visibility="Collapsed" CornerRadius="6" Padding="14,10" Background="#B30A0C10">
                <TextBlock Foreground="#7FD4FF" FontSize="13" Text="ALERTS appear here · drag to move" />
            </Border>
            <ItemsControl x:Name="MessageList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6" Margin="0,0,0,6" Background="{Binding Background}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="5" CornerRadius="6,0,0,6" Background="{Binding Accent}" />
                                <StackPanel Margin="12,8,16,9" MaxWidth="460">
                                    <StackPanel.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="4" Color="Black" Opacity="0.9" />
                                    </StackPanel.Effect>
                                    <TextBlock Text="{Binding Tag}" Foreground="{Binding Accent}" FontSize="11" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="20" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" Foreground="#CCFFFFFF" FontSize="12" TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</ui:OverlayWindow>
