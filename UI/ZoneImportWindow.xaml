<Window x:Class="SpawnTimer.UI.ZoneImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add drop alerts from a zone" Width="900" Height="660" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner" FontSize="13" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Zone + sources -->
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <TextBlock Text="Zone" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
                <Button x:Name="LoadButton" DockPanel.Dock="Right" Content="Load drops" Margin="6,0,0,0" Click="Load_Click" IsDefault="True" />
                <ComboBox x:Name="ZoneBox" />
            </DockPanel>
            <WrapPanel Margin="0,8,0,0">
                <TextBlock Text="Sources:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <CheckBox x:Name="WikiBox" IsChecked="True" Content="M&amp;M Wiki (Miraheze)" />
                <CheckBox x:Name="DropsBox" IsChecked="True" Content="MnM Drops (mnmdrops.com)" />
                <CheckBox x:Name="RefreshBox" Content="Re-download (ignore saved copy)" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#444" />
        </StackPanel>

        <!-- Attribution -->
        <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" FontSize="11" Foreground="#777" TextWrapping="Wrap" x:Name="AttributionText" />

        <!-- Actions -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="AddButton" Content="Add 0 items to drop alerts" Click="Add_Click" IsEnabled="False" FontWeight="SemiBold" />
                <Button Content="Close" IsCancel="True" Margin="0" Click="Close_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Tick suggested" Click="TickSuggested_Click"
                        ToolTip="Gear from named mobs that you aren't already alerting on" />
                <Button Content="Tick all shown" Click="TickShown_Click" />
                <Button Content="Untick all" Click="UntickAll_Click" />
            </StackPanel>
        </DockPanel>
        <CheckBox x:Name="AddNamedBox" DockPanel.Dock="Bottom" IsChecked="False" Margin="0,8,0,0">
            <TextBlock TextWrapping="Wrap"
                       Text="Also add this zone's lowercase-named mobs (e.g. &quot;an ashira alchemist&quot;) to the named watch list, since auto-detect only catches capitalized names" />
        </CheckBox>

        <!-- Filter -->
        <DockPanel DockPanel.Dock="Top" Margin="0,10,0,6">
            <CheckBox x:Name="NamedOnlyBox" DockPanel.Dock="Right" IsChecked="True" Margin="12,0,0,0"
                      Content="Named mobs only" Checked="Filter_Changed" Unchecked="Filter_Changed" />
            <TextBlock Text="Filter" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox x:Name="FilterBox" Padding="4,3" TextChanged="Filter_Changed" />
        </DockPanel>

        <DataGrid x:Name="ItemGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended"
                  IsReadOnly="False" RowHeaderWidth="0" HorizontalGridLinesBrush="#EEE">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AlreadyAlerting}" Value="True">
                            <Setter Property="Foreground" Value="#999" />
                            <Setter Property="ToolTip" Value="Already in your drop alert list" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="34" SortMemberPath="Selected">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" Margin="0"
                                      IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                      Click="RowCheck_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="2*" IsReadOnly="True" />
                <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Dropped by" Binding="{Binding DroppedBy}" Width="2*" IsReadOnly="True" />
                <DataGridTextColumn Header="" Binding="{Binding NamedText}" Width="60" IsReadOnly="True" />
                <DataGridTextColumn Header="Source" Binding="{Binding Sources}" Width="*" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
